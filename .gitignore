# Node / frontend
node_modules/
dist/

# Rust / Tauri (pattern có / chỉ khớp từ gốc repo — bỏ / để khớp mọi độ sâu)
target/
**/gen/schemas/

# Sidecar muse2api (PyInstaller)
videoflow-app/sidecar/build/
**/__pycache__/
# Runtime state của engine — data/accounts.json chứa COOKIE THẬT.
# config.py đặt data_dir TƯƠNG ĐỐI theo thư mục làm việc, nên `python -m muse2api` chạy từ
# gốc repo / videoflow-app / sidecar đều sinh data/ ở chỗ khác nhau → chặn mọi `data/`.
data/
**/data/
videoflow-app/sidecar/.env
.env
videoflow-app/sidecar/.venv/
.venv/
**/*.db
**/*.db-wal
**/*.db-shm
# Khoá updater (không bao giờ commit)
.updater-key.pem
.updater-key.pem.pub
.updater-pass.new

# Build artifacts
*.exe
*.msi
*.appx
*.nsis.zip
*.o
videoflow-app/src-tauri/app.manifest
videoflow-app/src-tauri/manifest.rc

# Workspace cục bộ (không thuộc mã nguồn)
_build/
.zcode/
rustup-init.exe

# Hệ thống / IDE
.DS_Store
Thumbs.db
*.log

# PDF tài liệu thiết kế — giữ local
*.pdf

# Updater signing key (never commit)
.updater-key.*

# Giữ thư mục binaries/ (sidecar build local, *.exe bị ignore)
!videoflow-app/src-tauri/binaries/
videoflow-app/src-tauri/binaries/*.exe
